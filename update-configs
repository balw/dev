#!/usr/bin/env bash

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dry="0"

if [ -z "$XDG_CONFIG_HOME" ]; then
    echo "no xdg config home"
    echo "using ~/.config"
    XDG_CONFIG_HOME=$HOME/.config
fi

while [[ $# > 0 ]]; do
    if [[ "$1" == "--dry" ]]; then
        dry="1"
    fi
    shift
done

log() {
    if [[ $dry == "1" ]]; then
        echo "[DRY_RUN]: $@"
    else
        echo "$@"
    fi
}

execute() {
    log "execute: $@"
    if [[ $dry == "1" ]]; then
        return
    fi

    "$@"
}

log "--------- dev-env ---------"

cd "$script_dir"
copy_dir() {
    pushd "$1" >/dev/null
    to=$2

    dirs=$(find . -maxdepth 1 -mindepth 1 -type d)
    for dir in $dirs; do
        execute rm -rf "$to/$dir"
        execute cp -r "$dir" "$to/$dir"
    done
    popd >/dev/null
}

copy_file() {
    from=$1
    to=$2
    execute rm -f "$to"
    execute cp "$from" "$to"
}

# ~/.config does not exist on a fresh machine
execute mkdir -p "$XDG_CONFIG_HOME"

copy_file "$script_dir/.config/.zshrc" "$HOME/.zshrc"
copy_file "$script_dir/.config/starship.toml" "$XDG_CONFIG_HOME/starship.toml"

copy_dir .config "$XDG_CONFIG_HOME"

# Claude Code reads ~/.claude, not $XDG_CONFIG_HOME
execute mkdir -p "$HOME/.claude"
copy_file "$script_dir/claude/settings.json" "$HOME/.claude/settings.json"

# Replaces only the skill folders that exist in skills/custom; vendor skills are left alone
execute mkdir -p "$HOME/.claude/skills"
copy_dir skills/custom "$HOME/.claude/skills"

# herdr's config dir also holds sockets, logs and sessions, so copy only the config file
execute mkdir -p "$XDG_CONFIG_HOME/herdr"
copy_file "$script_dir/herdr/config.toml" "$XDG_CONFIG_HOME/herdr/config.toml"

# Merges herdr's SessionStart hook into ~/.claude/settings.json, so it must run after the copy above
if command -v herdr >/dev/null 2>&1; then
    execute herdr integration install claude
fi
